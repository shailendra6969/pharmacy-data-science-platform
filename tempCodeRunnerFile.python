DB_PATH = "pharmacy_data.db"

def create_sqlite_db():
    """Create SQLite database with sample tables if it doesn't exist"""
    conn = sqlite3.connect(DB_PATH)
    cursor = conn.cursor()
    
    # Create drugs table
    cursor.execute('''
    CREATE TABLE IF NOT EXISTS drugs (
        id INTEGER PRIMARY KEY,
        name TEXT NOT NULL,
        category TEXT,
        price REAL,
        dosage TEXT,
        description TEXT,
        manufacturer TEXT,
        stock INTEGER
    )
    ''')
    
    # Create sales table
    cursor.execute('''
    CREATE TABLE IF NOT EXISTS sales (
        id INTEGER PRIMARY KEY,
        drug_id INTEGER,
        sale_date TEXT,
        quantity INTEGER,
        total_price REAL,
        FOREIGN KEY (drug_id) REFERENCES drugs (id)
    )
    ''')
    
    # Add sample data if the table is empty
    cursor.execute("SELECT COUNT(*) FROM drugs")
    if cursor.fetchone()[0] == 0:
        # Add sample drugs
        sample_drugs = [
            (1, "Atorvastatin", "Cardiovascular", 45.50, "20mg", "Cholesterol-lowering medication", "Pfizer", 500),
            (2, "Metformin", "Antidiabetic", 32.75, "500mg", "Oral diabetes medicine", "Merck", 750),
            (3, "Lisinopril", "Cardiovascular", 28.99, "10mg", "ACE inhibitor", "AstraZeneca", 600),
            (4, "Levothyroxine", "Thyroid", 22.50, "50mcg", "Thyroid hormone", "Abbott", 800),
            (5, "Amoxicillin", "Antibiotic", 15.25, "500mg", "Penicillin antibiotic", "GSK", 950),
            (6, "Azithromycin", "Antibiotic", 42.30, "250mg", "Macrolide antibiotic", "Pfizer", 450),
            (7, "Albuterol", "Respiratory", 55.80, "90mcg", "Bronchodilator", "GSK", 350),
            (8, "Omeprazole", "Gastrointestinal", 38.45, "20mg", "Proton pump inhibitor", "AstraZeneca", 600),
            (9, "Amlodipine", "Cardiovascular", 26.70, "5mg", "Calcium channel blocker", "Pfizer", 700),
            (10, "Sertraline", "Psychiatric", 65.30, "50mg", "Antidepressant", "Pfizer", 400)
        ]
        cursor.executemany("INSERT INTO drugs VALUES (?, ?, ?, ?, ?, ?, ?, ?)", sample_drugs)
        
        # Add sample sales data
        import random
        from datetime import datetime, timedelta
        
        sample_sales = []
        sale_id = 1
        # Generate 365 days of sales data
        for day in range(365):
            date = (datetime.now() - timedelta(days=365-day)).strftime('%Y-%m-%d')
            # Each drug has some sales on each day
            for drug_id in range(1, 11):
                # Add some randomness to quantities - higher on weekends
                is_weekend = (datetime.strptime(date, '%Y-%m-%d').weekday() >= 5)
                base_quantity = random.randint(3, 8) if is_weekend else random.randint(1, 5)
                # Add seasonality - more sales in winter for certain drugs
                month = datetime.strptime(date, '%Y-%m-%d').month
                is_winter = (month in [12, 1, 2])
                
                # Respiratory and antibiotic meds sell more in winter
                if (drug_id in [5, 6, 7]) and is_winter:
                    quantity = base_quantity * 2
                else:
                    quantity = base_quantity
                    
                # Get the price from the drugs table
                cursor.execute("SELECT price FROM drugs WHERE id = ?", (drug_id,))
                price = cursor.fetchone()[0]
                total = price * quantity
                
                sample_sales.append((sale_id, drug_id, date, quantity, total))
                sale_id += 1
        
        cursor.executemany("INSERT INTO sales VALUES (?, ?, ?, ?, ?)", sample_sales)
    
    conn.commit()
    conn.close()
    logger.info("SQLite database initialized with sample data")

# Create and populate the SQLite database
create_sqlite_db()

